# Site statique gaspiz.fr — remplace la configuration WordPress/LiteSpeed
# Ne rien remettre des blocs LSCACHE / WordPress : ils ne servent plus à rien.

RewriteEngine On
RewriteBase /

# Empêche Apache d'ajouter un slash aux répertoires réels.
# Sans cette ligne, /blog serait redirigé vers /blog/ (le dossier des
# articles) au lieu de servir blog.html.
DirectorySlash Off

# --- HTTPS forcé -------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Coulisses du site : jamais servies aux visiteurs -------------------
# content/ (les articles en Markdown), tools/ (le générateur) et .github/
# vivent dans le dépôt mais n'ont rien à faire sur le web : sans cette règle
# Google pourrait indexer le Markdown des articles en double du HTML.
RewriteRule ^(content|tools)/ - [F,L]
RewriteRule (^|/)\.(github|git) - [F,L]

# --- Redirections 301 depuis les anciennes URLs WordPress --------------
# Ces URLs étaient indexées par Google. Sans ces règles, elles
# renverraient 404 et le référencement acquis serait perdu.
# /applicationnondisponible existe toujours à l'identique : pas de
# redirection, la page est servie directement.
RewriteRule ^telecharger-gaspiz-application-anti-gaspi/?$ /telecharger [R=301,L]
RewriteRule ^commercants-gaspiz-application-commercants-guadeloupe-martinique-guyane/?$ /commercants [R=301,L]

# --- Slash final retiré ------------------------------------------------
# WordPress servait toutes ses URLs avec un slash final. On les ramène
# vers la forme sans slash, qui est la forme canonique du nouveau site.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# --- URL canonique : /page.html -> /page -------------------------------
# Le test sur THE_REQUEST ne matche que la requête d'origine du navigateur,
# jamais une réécriture interne : pas de boucle avec la règle suivante.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Sert /commercants depuis commercants.html -------------------------
# Pas de condition !-d ici : /blog doit servir blog.html bien qu'un
# dossier blog/ existe à côté.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# --- Page d'erreur -----------------------------------------------------
# Une vraie page 404, et non l'accueil : servir index.html ici donnait un
# « soft 404 », Google voyait du contenu d'accueil valide a des URLs qui
# n'existent pas et les indexait. 404.html n'utilise que des chemins
# absolus, elle reste correcte servie depuis /blog/nimportequoi.
ErrorDocument 404 /404.html

# --- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache navigateur --------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp        "access plus 6 months"
  ExpiresByType image/png         "access plus 6 months"
  ExpiresByType image/jpeg        "access plus 6 months"
  ExpiresByType audio/mpeg        "access plus 6 months"
  ExpiresByType text/css          "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html         "access plus 1 hour"
</IfModule>

# --- Divers ------------------------------------------------------------
Options -Indexes
